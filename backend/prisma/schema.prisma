generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum EntrySource {
  MANUAL
  WEB_AGENT
  WHATSAPP_TEXT
  WHATSAPP_AUDIO
  WHATSAPP_IMAGE
}

enum ChatSource {
  WEB
  WHATSAPP
}

enum ExpenseCategory {
  FUEL
  FEED_AND_SUPPLEMENT
  FERTILIZER_AND_SEED
  PESTICIDE
  ANIMAL_HEALTH
  PASTURE_AND_CROP_WORK
  MACHINERY_AND_MAINTENANCE
  LABOR
  OTHER
}

enum FarmAreaType {
  PASTURE
  CROP_FIELD
  OTHER
}

enum PendingActionStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum CattleCategory {
  CALVES
  HEIFERS
  COWS
  BULLS
  STEERS
  FINISHING
}

enum CattleSex {
  MALE
  FEMALE
}

enum CattleAnimalStatus {
  ACTIVE
  SOLD
  DECEASED
  TRANSFERRED
  MISSING
}

enum ActorType {
  USER
  AGENT
  SYSTEM
  INTEGRATION
}

enum DomainEventSource {
  WEB
  AGENT
  SYSTEM
  IMPORT
  INTEGRATION
  WHATSAPP
}

enum OutboxStatus {
  PENDING
  PROCESSED
  FAILED
}

enum RuleEvaluationStatus {
  PASSED
  TRIGGERED
  INSUFFICIENT_DATA
  ERROR
}

enum RuleSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AttentionItemStatus {
  NEW
  SEEN
  RESOLVED
}

enum AttentionScopeType {
  FARM
  PADDOCK
  LOT
  ANIMAL
}

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  phone         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ownedFarms Farm[]    @relation("FarmOwner")
  sessions   Session[]
  accounts   Account[]

  @@index([phone])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Farm {
  id          String @id @default(cuid())
  ownerUserId String
  owner       User   @relation("FarmOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)

  name                   String?
  totalAreaHa            Decimal? @db.Decimal(12, 2)
  primaryActivity        String?
  location               String?
  mainCrops              String?
  approximateAnimalCount Int?
  agentContext           String?

  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)

  defaultMaxGrazingDays        Int?
  defaultMinRestDays           Int?
  defaultStockingRateHeadPerHa Decimal? @db.Decimal(8, 2)

  onboardingCompleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chats          Chat[]
  expenses       Expense[]
  revenues       Revenue[]
  pendingActions PendingAction[]
  mapImages      FarmMapImage[]
  areas          FarmArea[]

  cattleLots      CattleLot[]
  cattleAnimals   CattleAnimal[]
  occupancies     PaddockOccupancy[]
  cattleMovements CattleMovement[]
  domainEvents    DomainEvent[]
  ruleEvaluations RuleEvaluation[]
  attentionItems  FarmAttentionItem[]
  idempotencyKeys IdempotencyKey[]

  @@unique([ownerUserId])
  @@map("farm")
}

model Chat {
  id     String @id @default(cuid())
  farmId String
  farm   Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)

  title  String?
  source ChatSource @default(WEB)

  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@index([farmId, archivedAt, updatedAt])
  @@map("chat")
}

model Message {
  id     String @id @default(cuid())
  chatId String
  chat   Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)

  role  String
  parts Json

  createdAt DateTime @default(now())

  @@index([chatId, createdAt])
  @@map("message")
}

model Expense {
  id     String @id @default(cuid())
  farmId String
  farm   Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)

  amount      Decimal         @db.Decimal(14, 2)
  date        DateTime        @db.Date
  description String
  category    ExpenseCategory
  source      EntrySource

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allocations ExpenseAllocation[]

  @@index([farmId, date])
  @@index([farmId, category])
  @@map("expense")
}

model ExpenseAllocation {
  id        String  @id @default(cuid())
  expenseId String
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  areaId String?
  area   FarmArea? @relation(fields: [areaId], references: [id], onDelete: Restrict)

  amount Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  @@index([expenseId])
  @@index([areaId])
  @@map("expense_allocation")
}

model Revenue {
  id     String @id @default(cuid())
  farmId String
  farm   Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)

  amount      Decimal     @db.Decimal(14, 2)
  date        DateTime    @db.Date
  description String
  source      EntrySource

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmId, date])
  @@map("revenue")
}

model PendingAction {
  id     String @id @default(cuid())
  farmId String
  farm   Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)

  toolName String
  args     Json

  status    PendingActionStatus @default(PENDING)
  expiresAt DateTime

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([farmId, status])
  @@map("pending_action")
}

model FarmMapImage {
  id     String @id @default(cuid())
  farmId String
  farm   Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)

  storageKey String
  widthPx    Int
  heightPx   Int
  uploadedAt DateTime @default(now())

  areas FarmArea[]

  @@index([farmId])
  @@map("farm_map_image")
}

model FarmArea {
  id     String @id @default(cuid())
  farmId String
  farm   Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)

  mapImageId String?
  mapImage   FarmMapImage? @relation(fields: [mapImageId], references: [id], onDelete: SetNull)

  name     String
  type     FarmAreaType
  hectares Decimal?     @db.Decimal(10, 2)
  shape    Json?
  metadata Json?

  usableAreaHa        Decimal? @db.Decimal(10, 2)
  maxGrazingDays      Int?
  minRestDays         Int?
  plannedCapacityHead Int?
  forageType          String?

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allocations   ExpenseAllocation[]
  occupancies   PaddockOccupancy[]
  movementsFrom CattleMovement[]    @relation("MovementOrigin")
  movementsTo   CattleMovement[]    @relation("MovementDestination")

  @@unique([farmId, name])
  @@index([farmId])
  @@index([mapImageId])
  @@map("farm_area")
}

model CattleLot {
  id     String @id @default(cuid())
  farmId String
  farm   Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)

  name      String
  category  CattleCategory
  purpose   String?
  headCount Int            @default(0)
  startedOn DateTime?      @db.Date
  notes     String?

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  animals     CattleAnimal[]
  occupancies PaddockOccupancy[]
  movements   CattleMovement[]

  @@unique([farmId, name])
  @@index([farmId, active])
  @@map("cattle_lot")
}

model CattleAnimal {
  id     String @id @default(cuid())
  farmId String
  farm   Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)

  lotId String?
  lot   CattleLot? @relation(fields: [lotId], references: [id], onDelete: SetNull)

  visualTag       String?
  electronicTag   String?
  sex             CattleSex
  breed           String?
  bornOn          DateTime?          @db.Date
  origin          String?
  acquiredOn      DateTime?          @db.Date
  acquisitionCost Decimal?           @db.Decimal(14, 2)
  status          CattleAnimalStatus @default(ACTIVE)
  notes           String?

  sireId String?
  sire   CattleAnimal?  @relation("AnimalSire", fields: [sireId], references: [id], onDelete: SetNull)
  sired  CattleAnimal[] @relation("AnimalSire")

  damId String?
  dam   CattleAnimal?  @relation("AnimalDam", fields: [damId], references: [id], onDelete: SetNull)
  borne CattleAnimal[] @relation("AnimalDam")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([farmId, visualTag])
  @@unique([farmId, electronicTag])
  @@index([farmId, status])
  @@index([lotId])
  @@map("cattle_animal")
}

model PaddockOccupancy {
  id     String @id @default(cuid())
  farmId String
  farm   Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)

  lotId String
  lot   CattleLot @relation(fields: [lotId], references: [id], onDelete: Cascade)

  paddockId String
  paddock   FarmArea @relation(fields: [paddockId], references: [id], onDelete: Restrict)

  startedAt DateTime
  endedAt   DateTime?

  correlationId String?

  createdAt DateTime @default(now())

  @@unique([lotId], where: { endedAt: null }, map: "paddock_occupancy_open_lot_key")
  @@index([farmId, startedAt])
  @@index([paddockId, startedAt])
  @@index([lotId, startedAt])
  @@map("paddock_occupancy")
}

model CattleMovement {
  id     String @id @default(cuid())
  farmId String
  farm   Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)

  lotId String
  lot   CattleLot @relation(fields: [lotId], references: [id], onDelete: Restrict)

  fromPaddockId String?
  fromPaddock   FarmArea? @relation("MovementOrigin", fields: [fromPaddockId], references: [id], onDelete: Restrict)

  toPaddockId String
  toPaddock   FarmArea @relation("MovementDestination", fields: [toPaddockId], references: [id], onDelete: Restrict)

  headCount Int

  occurredAt DateTime
  recordedAt DateTime @default(now())

  actorType ActorType
  actorId   String?
  source    DomainEventSource

  reason String?
  notes  String?

  correlationId String

  @@index([farmId, occurredAt])
  @@index([lotId, occurredAt])
  @@index([toPaddockId, occurredAt])
  @@index([correlationId])
  @@map("cattle_movement")
}

model DomainEvent {
  id     String @id @default(cuid())
  farmId String
  farm   Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)

  eventType    String
  eventVersion Int    @default(1)

  aggregateType String
  aggregateId   String

  actorType ActorType
  actorId   String?
  source    DomainEventSource

  correlationId String
  causationId   String?

  payload  Json
  metadata Json?

  occurredAt DateTime
  recordedAt DateTime @default(now())

  outbox          OutboxMessage?
  ruleEvaluations RuleEvaluation[]

  @@index([farmId, occurredAt])
  @@index([aggregateType, aggregateId, occurredAt])
  @@index([correlationId])
  @@map("domain_event")
}

model OutboxMessage {
  id      String      @id @default(cuid())
  eventId String      @unique
  event   DomainEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  lastError   String?
  availableAt DateTime     @default(now())
  processedAt DateTime?

  createdAt DateTime @default(now())

  @@index([status, availableAt])
  @@map("outbox_message")
}

model RuleEvaluation {
  id     String @id @default(cuid())
  farmId String
  farm   Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)

  triggerEventId String?
  triggerEvent   DomainEvent? @relation(fields: [triggerEventId], references: [id], onDelete: SetNull)
  correlationId  String

  ruleId      String
  ruleVersion Int

  status   RuleEvaluationStatus
  severity RuleSeverity?

  scopeType AttentionScopeType
  scopeId   String

  facts           Json
  configSnapshot  Json?
  suggestedAction Json?

  evaluatedAt DateTime @default(now())
  durationMs  Int?
  errorCode   String?

  attentionItems FarmAttentionItem[]

  @@index([farmId, evaluatedAt])
  @@index([correlationId])
  @@index([ruleId, evaluatedAt])
  @@unique([triggerEventId, ruleId, ruleVersion])
  @@map("rule_evaluation")
}

model FarmAttentionItem {
  id     String @id @default(cuid())
  farmId String
  farm   Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)

  ruleId      String
  ruleVersion Int

  scopeType AttentionScopeType
  scopeId   String

  ruleEvaluationId String?
  ruleEvaluation   RuleEvaluation? @relation(fields: [ruleEvaluationId], references: [id], onDelete: SetNull)

  correlationId String?

  category  String
  severity  RuleSeverity
  titleCode String

  facts           Json
  suggestedAction Json?

  status AttentionItemStatus @default(NEW)

  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  resolvedAt  DateTime?
  expiresAt   DateTime?

  @@unique([farmId, ruleId, scopeId], where: raw("status IN ('NEW', 'SEEN')"), map: "farm_attention_item_open_rule_scope_key")
  @@index([farmId, status, severity])
  @@index([correlationId])
  @@map("farm_attention_item")
}

model IdempotencyKey {
  id     String @id @default(cuid())
  farmId String
  farm   Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)

  scope       String
  key         String
  requestHash String

  result      Json?
  completedAt DateTime?

  createdAt DateTime  @default(now())
  expiresAt DateTime?

  @@unique([farmId, scope, key])
  @@index([expiresAt])
  @@map("idempotency_key")
}
