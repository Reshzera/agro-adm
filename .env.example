# Copie para .env. Um único .env na raiz serve backend e frontend — o Vite lê
# daqui via envDir e só expõe ao cliente as variáveis com prefixo VITE_.

# Banco
POSTGRES_USER=agro
POSTGRES_PASSWORD=agro
POSTGRES_DB=agro_adm
# Porta no host. 5432 dentro do container sempre; troque aqui se a 5432 do
# host já estiver ocupada por outro Postgres local.
POSTGRES_PORT=5433
DATABASE_URL="postgresql://agro:agro@localhost:5433/agro_adm?schema=public"

# Agente
OPENAI_API_KEY=

# Auth (ticket 04)
BETTER_AUTH_SECRET=

# URL pública da aplicação. Nasce sem uso; o ngrok do webhook do WhatsApp
# consome na fatia seguinte.
HOST_URL=http://localhost:3000

# Backend
PORT=3000
FRONTEND_URL=http://localhost:5173

# Frontend
VITE_BACKEND_URL=http://localhost:3000
